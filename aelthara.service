[Unit]
Description=Aelthara — Weather Intelligence Trading Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/opt/aelthara
EnvironmentFile=/opt/aelthara/.env
ExecStart=/opt/aelthara/venv/bin/python pulse.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/opt/aelthara/pulse.log
StandardError=append:/opt/aelthara/pulse.log

[Install]
WantedBy=multi-user.target
